# База данных (Supabase или локальный PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.supabase.co:5432/postgres

# JWT секрет (придумай длинный случайный ключ)
SECRET_KEY=your-very-long-secret-key-here-change-this

# Anthropic API ключ
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google OAuth
# Получить: console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Для разработки
DEBUG=true
